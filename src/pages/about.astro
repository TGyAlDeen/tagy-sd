---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE_AUTHOR, SITE_ROLE, SITE_LOCATION, SOCIALS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About" description={`About ${SITE_AUTHOR} — ${SITE_ROLE} based in ${SITE_LOCATION}.`} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<p class="eyebrow">About</p>
				<h1>{SITE_AUTHOR}</h1>
				<p class="muted">{SITE_ROLE} · {SITE_LOCATION}</p>
			</header>

			<div class="layout">
				<div class="prose">
					<p>
						I'm a software engineer who ended up owning the data layer. Day to day that means designing
						lakehouse platforms on <strong>Apache Iceberg</strong>, tuning <strong>Trino</strong> for
						interactive queries over billions of rows, and making sure <strong>Parquet</strong> files are
						laid out so nobody has to think about them.
					</p>
					<p>
						Before data platforms I did a Master's in deep learning, with published work on intrusion
						detection for IoT networks. I still reach for ML when the problem actually needs it — and push
						back when it doesn't.
					</p>
					<p>
						I write here about things I wish someone had written down: table-format internals, query-engine
						performance, and the operational side of running data infrastructure.
					</p>
					<!-- TODO: expand bio, add career timeline -->
				</div>

				<aside>
					<div class="panel">
						<div class="label mono muted">Currently</div>
						<ul>
							<li>Building data platforms in Tokyo</li>
							<li>Deep in Iceberg table maintenance & compaction</li>
							<li>Writing more, shipping side projects in Go</li>
						</ul>
					</div>
					<div class="panel">
						<div class="label mono muted">Elsewhere</div>
						<ul class="links">
							{SOCIALS.map((s) => (
								<li>
									<a href={s.href} target="_blank" rel="noopener noreferrer"><Icon name={s.icon} size={16} /> {s.name}</a>
								</li>
							))}
						</ul>
					</div>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head { margin-bottom: 2.5rem; }
	.page-head h1 { font-size: clamp(2rem, 4vw, 2.75rem); margin-bottom: 0.25rem; }
	.layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: 3rem;
		align-items: start;
	}
	.prose { font-size: 1.05rem; max-width: var(--prose); }
	aside { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 5rem; }
	.panel {
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.label { margin-bottom: 0.6rem; }
	ul { margin: 0; padding-left: 1.1rem; font-size: 0.925rem; color: var(--text-2); }
	li { margin-bottom: 0.35rem; }
	.links { list-style: none; padding: 0; }
	.links a { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--text-2); }
	.links a:hover { color: var(--accent-text); }
	@media (max-width: 800px) {
		.layout { grid-template-columns: 1fr; gap: 2rem; }
		aside { position: static; }
	}
</style>
