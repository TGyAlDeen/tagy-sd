---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { postLang, baseSlug, postUrl, type Lang } from '../../../i18n';

export async function getStaticPaths() {
	const all = await getCollection('blog');
	const ids = new Set(all.map((p) => p.id));
	return all
		.filter((post) => postLang(post.id) !== 'en')
		.map((post) => {
			const lang = postLang(post.id);
			const slug = baseSlug(post.id);
			const alternates: Partial<Record<Lang, string>> = { [lang]: postUrl(post.id) };
			if (ids.has(slug)) alternates.en = postUrl(slug);
			const other = lang === 'ja' ? 'ar' : 'ja';
			if (ids.has(`${other}/${slug}`)) alternates[other] = postUrl(`${other}/${slug}`);
			return { params: { lang, slug }, props: { post, lang, alternates } };
		});
}
type Props = {
	post: CollectionEntry<'blog'>;
	lang: Lang;
	alternates: Partial<Record<Lang, string>>;
};

const { post, lang, alternates } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} lang={lang} alternates={alternates}>
	<Content />
</BlogPost>
