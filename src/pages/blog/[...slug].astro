---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { postLang, postUrl, type Lang } from '../../i18n';

export async function getStaticPaths() {
	const all = await getCollection('blog');
	const ids = new Set(all.map((p) => p.id));
	return all
		.filter((post) => postLang(post.id) === 'en')
		.map((post) => {
			const alternates: Partial<Record<Lang, string>> = { en: postUrl(post.id) };
			for (const l of ['ja', 'ar'] as const) {
				if (ids.has(`${l}/${post.id}`)) alternates[l] = postUrl(`${l}/${post.id}`);
			}
			return { params: { slug: post.id }, props: { post, alternates } };
		});
}
type Props = { post: CollectionEntry<'blog'>; alternates: Partial<Record<Lang, string>> };

const { post, alternates } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} lang="en" alternates={alternates}>
	<Content />
</BlogPost>
