---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="404" description={`Page not found — ${SITE_TITLE}`} />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<Header />
		<main>
			<div class="wrap">
				<p class="code mono">404</p>
				<h1>This page doesn't exist.</h1>
				<p class="muted">The URL may be wrong, or the page moved. These are all real:</p>
				<div class="links">
					<a class="btn primary" href="/">Home</a>
					<a class="btn" href="/blog/">Blog</a>
					<a class="btn" href="/ja/" lang="ja">日本語</a>
					<a class="btn" href="/ar/" lang="ar">العربية</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.wrap {
		min-height: 45vh;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 0.5rem;
	}
	.code {
		font-size: clamp(3.5rem, 10vw, 6rem);
		font-weight: 700;
		color: var(--accent-text);
		margin: 0;
		line-height: 1;
	}
	h1 { margin: 0.5rem 0; }
	.links {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: 1rem;
	}
</style>
