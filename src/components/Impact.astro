---
import { IMPACT, SECTORS } from '../data/impact';
import { HOME, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const h = HOME[lang];
---

<section class="section" id="impact">
	<div class="section-head">
		<div>
			<p class="eyebrow">{h.impactEyebrow}</p>
			<h2>{h.impactTitle}</h2>
		</div>
	</div>
	<ul class="sectors">
		{SECTORS.map((s) => <li class="tag" data-sector>{s[lang]}</li>)}
	</ul>
	<div class="grid">
		{IMPACT.map((o) => (
			<article class={o.featured ? 'outcome featured' : 'outcome'} data-impact data-featured={o.featured || undefined}>
				<p class="sector mono">
					{o.featured && <span class="now">{h.impactNow}</span>}
					{o.sector[lang]}
				</p>
				<h3>{o.title[lang]}</h3>
				<p class="body">{o.body[lang]}</p>
				<p class="tech mono">{o.tech}</p>
			</article>
		))}
	</div>
</section>

<style>
	.sectors {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0 0 1.5rem;
		padding: 0;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.outcome {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.sector {
		margin: 0;
		color: var(--accent-text);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.featured {
		grid-column: 1 / -1;
		border-color: var(--accent);
		background:
			radial-gradient(closest-side at 0% 0%, var(--accent-soft), transparent),
			var(--surface);
	}
	.featured h3 { font-size: 1.35rem; }
	.featured .body { max-width: 72ch; }
	.now {
		display: inline-block;
		margin-inline-end: 0.6rem;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background: var(--accent-text);
		color: var(--bg);
		letter-spacing: 0.04em;
	}
	h3 { margin: 0; font-size: 1.1rem; }
	.body { margin: 0; flex: 1; font-size: 0.925rem; color: var(--text-2); }
	.tech {
		margin: 0;
		padding-top: 0.6rem;
		border-top: 1px solid var(--border);
		color: var(--muted);
	}
	/* The mono face has no Arabic glyphs and tracking breaks letter joining. */
	:global([dir='rtl']) .sector,
	:global([dir='rtl']) .sectors .tag {
		font-family: var(--font-sans);
		letter-spacing: 0;
	}
	@media (max-width: 860px) {
		.grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 560px) {
		.grid { grid-template-columns: 1fr; }
	}
</style>
