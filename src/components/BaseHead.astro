---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE, SITE_AUTHOR, SITE_ROLE, SOCIALS } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, type = 'website', publishedTime, modifiedTime } = Astro.props;
const fullTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;
// Social/search scrapers don't render SVG — only use raster images for og:image.
const ogImage = image && !image.endsWith('.svg') ? image : '/og-default.png';

const personLd = {
	'@type': 'Person',
	name: SITE_AUTHOR,
	jobTitle: SITE_ROLE,
	url: Astro.site?.toString(),
	sameAs: SOCIALS.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};

const jsonLd =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				url: canonicalURL.toString(),
				datePublished: publishedTime?.toISOString(),
				...(modifiedTime && { dateModified: modifiedTime.toISOString() }),
				image: new URL(ogImage, Astro.site).toString(),
				author: personLd,
				publisher: personLd,
				mainEntityOfPage: canonicalURL.toString(),
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				description,
				url: Astro.site?.toString(),
				author: personLd,
			};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE_AUTHOR} />
<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />

<!-- Theme: apply before first paint to avoid flash -->
<script is:inline>
	(() => {
		try {
			const stored = localStorage.getItem('theme');
			const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			document.documentElement.dataset.theme = stored === 'dark' || stored === 'light' ? stored : system;
		} catch {
			document.documentElement.dataset.theme = 'light';
		}
	})();
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && <meta property="article:author" content={SITE_AUTHOR} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(ogImage, Astro.site ?? Astro.url)} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
