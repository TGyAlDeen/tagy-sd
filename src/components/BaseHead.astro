---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE, SITE_AUTHOR, SITE_ROLE, SOCIALS } from '../consts';
import { OG_LOCALE, type Lang } from '../i18n';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	lang?: Lang;
	alternates?: Partial<Record<Lang, string>>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image,
	type = 'website',
	publishedTime,
	modifiedTime,
	lang = 'en',
	alternates,
} = Astro.props;
const fullTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;
// Social/search scrapers don't render SVG. Every animated hero has a
// pre-rendered PNG twin under /blog/og/ (generated at authoring time).
const heroRaster =
	image && image.startsWith('/blog/hero-') && image.endsWith('.svg')
		? image.replace('/blog/hero-', '/blog/og/hero-').replace(/\.svg$/, '.png')
		: null;
const ogImage = heroRaster ?? (image && !image.endsWith('.svg') ? image : '/og-default.png');
const ogSize = heroRaster ? { w: 1200, h: 600 } : { w: 1200, h: 630 };

const personLd = {
	'@type': 'Person',
	name: SITE_AUTHOR,
	jobTitle: SITE_ROLE,
	url: Astro.site?.toString(),
	sameAs: SOCIALS.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};

const jsonLd =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				url: canonicalURL.toString(),
				inLanguage: lang,
				datePublished: publishedTime?.toISOString(),
				...(modifiedTime && { dateModified: modifiedTime.toISOString() }),
				image: new URL(ogImage, Astro.site).toString(),
				author: personLd,
				publisher: personLd,
				mainEntityOfPage: canonicalURL.toString(),
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				description,
				inLanguage: lang,
				url: Astro.site?.toString(),
				author: personLd,
			};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE_AUTHOR} />
<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />

<!-- Theme: apply before first paint to avoid flash -->
<script is:inline>
	(() => {
		try {
			const stored = localStorage.getItem('theme');
			const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			document.documentElement.dataset.theme = stored === 'dark' || stored === 'light' ? stored : system;
		} catch {
			document.documentElement.dataset.theme = 'light';
		}
	})();
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL(lang === 'en' ? 'rss.xml' : `${lang}/rss.xml`, Astro.site)} />
<link rel="sitemap" href="/sitemap-index.xml" />
{
	alternates &&
		Object.entries(alternates).map(([l, href]) => (
			<link rel="alternate" hreflang={l} href={new URL(href, Astro.site).toString()} />
		))
}
{
	alternates?.en && (
		<link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site).toString()} />
	)
}

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url)} />
<meta property="og:image:width" content={String(ogSize.w)} />
<meta property="og:image:height" content={String(ogSize.h)} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && <meta property="article:author" content={SITE_AUTHOR} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(ogImage, Astro.site ?? Astro.url)} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
