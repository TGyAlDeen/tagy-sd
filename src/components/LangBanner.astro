---
// First-visit language suggestion + sticky preference routing.
// No server-side redirects (crawler-safe): everything happens client-side.
import { UI, type Lang } from '../i18n';

interface Props {
	lang: Lang;
	alternates: Partial<Record<Lang, string>>;
}
const { lang, alternates } = Astro.props;
const texts = Object.fromEntries(
	Object.keys(alternates).map((l) => [
		l,
		{ msg: UI[l as Lang].alsoAvailable, go: UI[l as Lang].switchTo, close: UI[l as Lang].dismiss },
	]),
);
---

<div id="lang-banner" class="lang-banner" hidden>
	<span id="lang-banner-msg"></span>
	<a id="lang-banner-go" href="#"></a>
	<button id="lang-banner-x" type="button" aria-label="Dismiss">✕</button>
</div>

<script is:inline define:vars={{ lang, alternates, texts }}>
	(() => {
		// Storage helpers resilient to blocked/cleared localStorage (private
		// windows, strict privacy settings): read falls back to sessionStorage,
		// durable writes go to both.
		const get = (k) => {
			let v = null;
			try { v = localStorage.getItem(k); } catch {}
			if (v === null) { try { v = sessionStorage.getItem(k); } catch {} }
			return v;
		};
		const setBoth = (k, v) => {
			try { localStorage.setItem(k, v); } catch {}
			try { sessionStorage.setItem(k, v); } catch {}
		};
		const setSession = (k, v) => { try { sessionStorage.setItem(k, v); } catch {} };
		try {
			const pref = get('langPref');
			// Sticky choice: route to the preferred language — but ONLY on the
			// session's entry page; after that, navigation is deliberate.
			const routed = get('langRouted');
			setSession('langRouted', '1');
			if (!routed && pref && pref !== lang && alternates[pref]) {
				location.replace(alternates[pref]);
				return;
			}
			// Suggestion: at most ONCE per session, and never after a dismissal
			// or an explicit language choice.
			if (pref || get('langSuggestDone') || get('langSuggestShown')) return;
			const nav = (navigator.language || '').slice(0, 2);
			if (nav === lang || !alternates[nav] || !texts[nav]) return;
			const el = document.getElementById('lang-banner');
			const go = document.getElementById('lang-banner-go');
			document.getElementById('lang-banner-msg').textContent = texts[nav].msg;
			go.textContent = texts[nav].go;
			go.href = alternates[nav];
			go.addEventListener('click', () => setBoth('langPref', nav));
			document.getElementById('lang-banner-x').addEventListener('click', () => {
				el.hidden = true;
				setBoth('langSuggestDone', '1');
			});
			el.hidden = false;
			setSession('langSuggestShown', '1');
		} catch {}
	})();
</script>

<style>
	.lang-banner {
		position: fixed;
		inset-inline: 0;
		bottom: 1.25rem;
		margin: 0 auto;
		width: fit-content;
		max-width: calc(100% - 2rem);
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.65rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--border-strong);
		background: var(--surface);
		box-shadow: var(--shadow);
		font-size: 0.875rem;
		z-index: 60;
	}
	.lang-banner a {
		font-weight: 600;
		white-space: nowrap;
	}
	.lang-banner button {
		border: 0;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		font-size: 0.85rem;
		padding: 0.15rem;
	}
	.lang-banner button:hover {
		color: var(--text);
	}
</style>
