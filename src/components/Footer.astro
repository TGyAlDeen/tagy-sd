---
import Icon from './Icon.astro';
import { SITE_AUTHOR, SOCIALS } from '../consts';
const today = new Date();
---

<footer>
	<div class="container inner">
		<div class="left">
			<span>&copy; {today.getFullYear()} {SITE_AUTHOR}</span>
		</div>
		<div class="social">
			{SOCIALS.map((s) => (
				<a href={s.href} target="_blank" rel="noopener noreferrer" title={s.name}>
					<span class="sr-only">{s.name}</span>
					<Icon name={s.icon} size={18} />
				</a>
			))}
			<a href="/rss.xml" title="RSS feed">
				<span class="sr-only">RSS</span>
				<Icon name="rss" size={18} />
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		background: var(--bg-elev);
		font-size: 0.875rem;
		color: var(--text-2);
	}
	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.75rem;
		padding-bottom: 1.75rem;
		flex-wrap: wrap;
	}
	.left { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
	.social { display: flex; gap: 0.25rem; }
	.social a {
		display: inline-grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		color: var(--text-2);
	}
	.social a:hover { color: var(--text); background: var(--surface-2); text-decoration: none; }
</style>
