---
import { STACK } from '../data/stack';
import { HOME, type Lang } from '../i18n';

interface Props {
	lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const h = HOME[lang];
---

<section class="section">
	<div class="section-head">
		<div>
			<p class="eyebrow">{h.stackEyebrow}</p>
			<h2>{h.stackTitle}</h2>
		</div>
	</div>
	<div class="groups">
		{STACK.map((g) => (
			<div class="group">
				<div class="label mono muted">{g.label}</div>
				<div class="items">{g.items.map((i) => <span class="tag">{i}</span>)}</div>
			</div>
		))}
	</div>
</section>

<style>
	.groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 1rem;
	}
	.group {
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.label { margin-bottom: 0.7rem; }
	.items { display: flex; flex-wrap: wrap; gap: 0.4rem; }
</style>
