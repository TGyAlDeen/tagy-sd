---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { SITE_HANDLE, SOCIALS } from '../consts';
---

<header class="site-header">
	<nav class="container">
		<a href="/" class="brand mono" aria-label="Home"><span class="prompt">~/</span>{SITE_HANDLE}</a>

		<input id="nav-toggle" class="nav-toggle" type="checkbox" aria-hidden="true" />
		<label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation">
			<Icon name="menu" size={20} />
		</label>

		<div class="links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<div class="right">
			<div class="social">
				{SOCIALS.map((s) => (
					<a href={s.href} target="_blank" rel="noopener noreferrer" title={s.name}>
						<span class="sr-only">{s.name}</span>
						<Icon name={s.icon} size={18} />
					</a>
				))}
			</div>
			<ThemeToggle />
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 80%, transparent);
		backdrop-filter: saturate(160%) blur(12px);
		-webkit-backdrop-filter: saturate(160%) blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		height: 3.75rem;
	}
	.brand {
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--text);
	}
	.brand:hover { text-decoration: none; }
	.prompt { color: var(--accent-text); }
	.links {
		display: flex;
		gap: 0.25rem;
		margin-left: 0.5rem;
	}
	.right {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.social {
		display: flex;
		gap: 0.25rem;
	}
	.social a {
		display: inline-grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		color: var(--text-2);
	}
	.social a:hover { color: var(--text); background: var(--surface-2); text-decoration: none; }
	.nav-toggle, .nav-burger { display: none; }

	@media (max-width: 720px) {
		nav { flex-wrap: wrap; height: auto; min-height: 3.75rem; padding-top: 0.6rem; padding-bottom: 0.6rem; }
		.nav-burger {
			display: inline-grid;
			place-items: center;
			width: 2.25rem;
			height: 2.25rem;
			border-radius: 999px;
			border: 1px solid var(--border);
			color: var(--text-2);
			cursor: pointer;
			order: 3;
		}
		.right { order: 2; margin-left: auto; }
		.social { display: none; }
		.links {
			order: 4;
			flex-basis: 100%;
			flex-direction: column;
			display: none;
			margin: 0.5rem 0 0.25rem;
			padding-top: 0.5rem;
			border-top: 1px solid var(--border);
		}
		.nav-toggle:checked ~ .links { display: flex; }
	}
</style>
