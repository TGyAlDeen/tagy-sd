---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { SITE_HANDLE, SOCIALS } from '../consts';
import { LOCALES, LANG_LABEL, UI, blogIndexUrl, type Lang } from '../i18n';

interface Props {
	lang?: Lang;
	alternates?: Partial<Record<Lang, string>>;
}
const { lang = 'en', alternates } = Astro.props;
// Default targets: each locale's blog index (used on pages without a direct translation).
const langTargets: Partial<Record<Lang, string>> = alternates ?? {
	en: '/',
	ja: '/ja/',
	ar: '/ar/',
};
const t = UI[lang];
const homeUrl = lang === 'en' ? '/' : `/${lang}/`;
const aboutUrl = lang === 'en' ? '/about/' : `/${lang}/about/`;
---

<header class="site-header">
	<nav class="container">
		<a href={homeUrl} class="brand mono" aria-label={t.home}><span class="prompt">~/</span>{SITE_HANDLE}</a>

		<input id="nav-toggle" class="nav-toggle" type="checkbox" aria-label="Toggle navigation" />
		<label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation">
			<Icon name="menu" size={20} />
		</label>

		<div class="links">
			<HeaderLink href={homeUrl}>{t.home}</HeaderLink>
			<HeaderLink href={blogIndexUrl(lang)}>{t.blog}</HeaderLink>
			<HeaderLink href={aboutUrl}>{t.about}</HeaderLink>
		</div>

		<div class="right">
			<div class="lang mono" aria-label="Language">
				{
					LOCALES.map(
						(l) =>
							langTargets[l] && (
								<a href={langTargets[l]} class:list={[{ active: l === lang }]} data-setlang={l} lang={l}>
									{LANG_LABEL[l]}
								</a>
							),
					)
				}
			</div>
			<div class="social">
				{SOCIALS.map((s) => (
					<a href={s.href} target="_blank" rel="noopener noreferrer" title={s.name}>
						<span class="sr-only">{s.name}</span>
						<Icon name={s.icon} size={18} />
					</a>
				))}
			</div>
			<ThemeToggle />
		</div>
	</nav>
</header>

<script>
	document.querySelectorAll('[data-setlang]').forEach((a) => {
		a.addEventListener('click', () => {
			const v = (a as HTMLElement).dataset.setlang ?? 'en';
			try {
				localStorage.setItem('langPref', v);
			} catch {}
			try {
				sessionStorage.setItem('langPref', v);
			} catch {}
		});
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 80%, transparent);
		backdrop-filter: saturate(160%) blur(12px);
		-webkit-backdrop-filter: saturate(160%) blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		height: 3.75rem;
	}
	.brand {
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--text);
	}
	.brand:hover { text-decoration: none; }
	.prompt { color: var(--accent-text); }
	.links {
		display: flex;
		gap: 0.25rem;
		margin-inline-start: 0.5rem;
	}
	.right {
		margin-inline-start: auto;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.lang {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.2rem 0.35rem;
		background: var(--surface);
	}
	.lang a {
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		font-size: 0.72rem;
		color: var(--muted);
		white-space: nowrap;
	}
	.lang a:hover { color: var(--text); text-decoration: none; }
	.lang a.active { background: var(--surface-2); color: var(--text); }
	.social {
		display: flex;
		gap: 0.25rem;
	}
	.social a {
		display: inline-grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		color: var(--text-2);
	}
	.social a:hover { color: var(--text); background: var(--surface-2); text-decoration: none; }
	.nav-toggle, .nav-burger { display: none; }

	@media (max-width: 800px) {
		.social { display: none; }
	}
	@media (max-width: 720px) {
		nav { flex-wrap: wrap; height: auto; min-height: 3.75rem; padding-top: 0.6rem; padding-bottom: 0.6rem; }
		/* Keyboard-accessible: focusable but visually hidden; Space toggles it. */
		.nav-toggle {
			display: block;
			position: absolute;
			width: 1px;
			height: 1px;
			opacity: 0;
			margin: 0;
			pointer-events: none;
		}
		.nav-toggle:focus-visible ~ .nav-burger {
			outline: 2px solid var(--accent);
			outline-offset: 2px;
		}
		.nav-burger {
			display: inline-grid;
			place-items: center;
			width: 2.25rem;
			height: 2.25rem;
			border-radius: 999px;
			border: 1px solid var(--border);
			color: var(--text-2);
			cursor: pointer;
			order: 3;
		}
		.right { order: 2; margin-inline-start: auto; }
		.links {
			order: 4;
			flex-basis: 100%;
			flex-direction: column;
			display: none;
			margin: 0.5rem 0 0.25rem;
			padding-top: 0.5rem;
			border-top: 1px solid var(--border);
		}
		.nav-toggle:checked ~ .links { display: flex; }
	}
</style>
