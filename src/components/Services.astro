---
import { SERVICES } from '../data/services';
import { HOME, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const h = HOME[lang];
---

<section class="section" id="services">
	<div class="section-head">
		<div>
			<p class="eyebrow">{h.servicesEyebrow}</p>
			<h2>{h.servicesTitle}</h2>
		</div>
	</div>
	<div class="grid">
		{SERVICES.map((s) => (
			<div class="service spec" data-service>
				<h3>{s.title[lang]}</h3>
				<p>{s.body[lang]}</p>
				<div class="tags">{s.tags.map((t) => <span class="tag">{t}</span>)}</div>
			</div>
		))}
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
	}
	.service {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: var(--card-shadow);
	}
	h3 { margin: 0; font-size: 1.05rem; }
	p { margin: 0; flex: 1; font-size: 0.925rem; color: var(--text-2); }
	.tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
</style>
