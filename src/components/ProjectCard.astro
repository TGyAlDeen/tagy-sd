---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
type Props = { project: Project };
const { project: p } = Astro.props;
---

<a class="card" href={p.href} target="_blank" rel="noopener noreferrer">
	<div class="top">
		<h3 class="mono">{p.name}</h3>
		<span class="meta">
			{p.stars != null && <span class="stars"><Icon name="star" size={12} /> {p.stars}</span>}
			<Icon name="external" size={14} />
		</span>
	</div>
	<p>{p.description}</p>
	<div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
</a>

<style>
	.top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
	h3 { margin: 0; font-size: 0.95rem; font-weight: 600; color: var(--text); }
	.meta { display: flex; align-items: center; gap: 0.6rem; color: var(--muted); font-size: 0.75rem; }
	.stars { display: inline-flex; align-items: center; gap: 0.25rem; font-family: var(--font-mono); }
	p { margin: 0; font-size: 0.925rem; color: var(--text-2); flex: 1; }
	.tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
</style>
