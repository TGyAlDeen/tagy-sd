---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & { readingTime?: string };

const { title, description, pubDate, updatedDate, heroImage, readingTime } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate}
		/>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="title">
					<div class="meta mono muted">
						<FormattedDate date={pubDate} />
						{readingTime && <span>· {readingTime}</span>}
						{updatedDate && <span>· updated <FormattedDate date={updatedDate} /></span>}
					</div>
					<h1>{title}</h1>
					<p class="desc">{description}</p>
				</header>
				{heroImage && <img class="hero-image" width={1020} height={510} src={heroImage} alt="" />}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: var(--prose); }
	.title { margin-bottom: 2rem; }
	.meta { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
	h1 { font-size: clamp(2rem, 4.5vw, 2.75rem); }
	.desc { font-size: 1.125rem; color: var(--text-2); margin: 0; }
	.hero-image { display: block; width: 100%; margin: 0 0 2.5rem; border-radius: var(--radius); border: 1px solid var(--border); }
	.prose { font-size: 1.05rem; color: var(--text); }
	.prose :global(h2) { margin-top: 2.5rem; font-size: 1.6rem; }
	.prose :global(h3) { margin-top: 2rem; }
	.prose :global(img) { border: 1px solid var(--border); }
	.prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; }
	.prose :global(li) { margin-bottom: 0.35rem; }
</style>
